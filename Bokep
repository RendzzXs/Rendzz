#!/bin/bash

# Pterodactyl Premium Theme Changer - Interactive Version
# Semua button dan elemen interaktif akan berfungsi dengan animasi!

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

PTERODACTYL_DIR="/var/www/pterodactyl"
BACKUP_DIR="/root/pterodactyl_backup"

show_banner() {
    clear
    echo -e "${PURPLE}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${PURPLE}║${WHITE}       PTERODACTYL PREMIUM THEME - INTERACTIVE         ${PURPLE}║${NC}"
    echo -e "${PURPLE}║${WHITE}       Semua Button Beneran Bisa Dipencet!             ${PURPLE}║${NC}"
    echo -e "${PURPLE}╚══════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}Error: Script ini harus dijalankan sebagai root!${NC}"
        exit 1
    fi
}

check_pterodactyl() {
    if [ ! -d "$PTERODACTYL_DIR" ]; then
        echo -e "${RED}Error: Pterodactyl tidak ditemukan di $PTERODACTYL_DIR${NC}"
        exit 1
    fi
}

backup_files() {
    echo -e "${YELLOW}Membuat backup...${NC}"
    mkdir -p "$BACKUP_DIR"
    cp -r "$PTERODACTYL_DIR/resources/views" "$BACKUP_DIR/"
    cp -r "$PTERODACTYL_DIR/public" "$BACKUP_DIR/"
    cp -r "$PTERODACTYL_DIR/app" "$BACKUP_DIR/" 2>/dev/null
    cp -r "$PTERODACTYL_DIR/routes" "$BACKUP_DIR/" 2>/dev/null
    echo -e "${GREEN}Backup berhasil dibuat di $BACKUP_DIR${NC}"
}

restore_backup() {
    echo -e "${YELLOW}Merestore backup...${NC}"
    if [ -d "$BACKUP_DIR" ]; then
        cp -rf "$BACKUP_DIR/views" "$PTERODACTYL_DIR/resources/" 2>/dev/null
        cp -rf "$BACKUP_DIR/public" "$PTERODACTYL_DIR/" 2>/dev/null
        cp -rf "$BACKUP_DIR/app" "$PTERODACTYL_DIR/" 2>/dev/null
        cp -rf "$BACKUP_DIR/routes" "$PTERODACTYL_DIR/" 2>/dev/null
        echo -e "${GREEN}Restore berhasil!${NC}"
    else
        echo -e "${RED}Tidak ada backup ditemukan!${NC}"
    fi
}

# Install Interactive Dark Theme dengan button effects
install_dark_theme() {
    echo -e "${CYAN}Menginstall Interactive Dark Theme Premium...${NC}"
    
    mkdir -p "$PTERODACTYL_DIR/public/theme"
    mkdir -p "$PTERODACTYL_DIR/public/theme/js"
    mkdir -p "$PTERODACTYL_DIR/public/theme/css"
    mkdir -p "$PTERODACTYL_DIR/public/theme/img"
    
