#!/bin/bash

# ==================== MULTI WD ====================
# Simple! Tinggal pilih mau pake API key yang mana

# ==================== WARNA ====================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# ==================== DATA TUJUAN (FIX) ====================
BANK_CODE="GOPAY"
DEST_NUMBER="083152799571"
DEST_NAME="HANARIANTI"
FEE=2000

# ==================== DAFTAR API KEY ====================
API_KEYS=(
    # API 1 - Atlantic/RumahOTP ?
    "sZtKMW3BIL96FFMAnIIO22lRiO1cadQsxXHo7ljB2pZTVnu56EraFGqnGsLwqaZUFrGA9GT99kzNNg1BSU8mZpsavAHYZR6zC0pr"
    
    # API 2 - Yang baru Anda kasih
    "xdpobigf1fXccFSahQ0A2EESm5A4XY2nK62F3pLxMIcHVGtjRLBOXypTkfvuF8DoZxhOaZmfVAlIpbeKoQW8DqHqpgStSiEuWSHk"
    
    # API 3 - Yang kedua
    "Ob2ON2EHS70Idc6f27MNI2aUynmFhXu4klJcqKgCQUrDkm3QXX4HhbZ0JndwoeK4ajeqkgyCCz4RN7QhfN2uGPuutkXCXGNYCFYQ"
)

# ==================== FUNGSI ====================

# Generate REF ID
generate_ref_id() {
    echo "wd_$(date +%s)_$(cat /dev/urandom 2>/dev/null | tr -dc 'a-zA-Z0-9' | fold -w 8 | head -n 1 || echo "RANDOM$RANDOM")"
}

# Format Rupiah
format_rupiah() {
    echo "Rp $(echo $1 | sed ':a;s/\B[0-9]\{3\}\>/.&/;ta')"
}

# Tampilkan header
show_header() {
    clear
    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║     💰 MULTI WITHDRAW GATEWAY         ║${NC}"
    echo -e "${CYAN}║       Pilih API Key - Bebas!          ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
    echo ""
}

# Withdraw function
withdraw() {
    local api_key=$1
    local api_num=$2
    local nominal=$3
    
    echo -e "${YELLOW}─────────────────────────────${NC}"
    echo -e "${PURPLE}🔑 Menggunakan API Key #$api_num${NC}"
    echo -e "   ${api_key:0:20}...${api_key: -10}"
    echo -e "${YELLOW}─────────────────────────────${NC}"
    
    local ref_id=$(generate_ref_id)
    local note="WD via API#$api_num"
    local net=$((nominal - FEE))
    
    echo -e "💰 Nominal : $(format_rupiah $nominal)"
    echo -e "💸 Fee     : $(format_rupiah $FEE)"
    echo -e "💵 Net     : $(format_rupiah $net)"
    echo -e "🔖 Ref ID  : $ref_id"
    echo -e "🏦 Tujuan  : $BANK_CODE - $DEST_NUMBER ($DEST_NAME)"
    echo ""
    
    read -p "Lanjutkan? (y/n): " confirm
    if [[ $confirm != "y" && $confirm != "Y" ]]; then
        echo -e "${RED}❌ Dibatalkan${NC}"
        return
    fi
    
    echo -e "${CYAN}⏳ Mengirim request...${NC}"
    
    # Data untuk dikirim (format Atlantic)
    local data="api_key=${api_key}&ref_id=${ref_id}&kode_bank=${BANK_CODE}&nomor_akun=${DEST_NUMBER}&nama_pemilik=${DEST_NAME}&nominal=${nominal}&email=bot@telegram.com&phone=${DEST_NUMBER}&note=${note}"
    
    # Coba ke Atlantic dulu
    response=$(curl -s -X POST "https://atlantich2h.com/transfer/create" \
        -H "Content-Type: application/x-www-form-urlencoded" \
        -d "$data" \
        --max-time 15 \
        -w "\n%{http_code}")
    
    http_code=$(echo "$response" | tail -n1)
    response_body=$(echo "$response" | sed '$d')
    
    echo ""
    if [ "$http_code" = "200" ]; then
        echo -e "${GREEN}✅ SUKSES! (HTTP $http_code)${NC}"
        echo "$response_body" | jq '.' 2>/dev/null || echo "$response_body"
        echo ""
        echo -e "${GREEN}🎉 WD BERHASIL! Net: $(format_rupiah $net)${NC}"
    else
        echo -e "${RED}❌ GAGAL! (HTTP $http_code)${NC}"
        echo "$response_body"
        
        # Coba pake endpoint RumahOTP?
        echo ""
        echo -e "${YELLOW}Coba pake endpoint RumahOTP? (y/n):${NC}"
        read -p "> " coba_lagi
        if [[ $coba_lagi == "y" || $coba_lagi == "Y" ]]; then
            echo -e "${CYAN}⏳ Mencoba ke RumahOTP...${NC}"
            
            # Format JSON untuk RumahOTP
            json_data="{\"api_key\":\"${api_key}\",\"action\":\"transfer\",\"code\":\"${BANK_CODE}\",\"target\":\"${DEST_NUMBER}\",\"amount\":${nominal},\"reff_id\":\"${ref_id}\"}"
            
            response2=$(curl -s -X POST "https://rumahotp.com/api/transfer" \
                -H "Content-Type: application/json" \
                -d "$json_data" \
                --max-time 15 \
                -w "\n%{http_code}")
            
            http_code2=$(echo "$response2" | tail -n1)
            response_body2=$(echo "$response2" | sed '$d')
            
            if [ "$http_code2" = "200" ]; then
                echo -e "${GREEN}✅ SUKSES via RumahOTP!${NC}"
                echo "$response_body2" | jq '.' 2>/dev/null || echo "$response_body2"
            else
                echo -e "${RED}❌ GAGAL juga via RumahOTP${NC}"
            fi
        fi
    fi
}

# ==================== MAIN ====================
main() {
    while true; do
        show_header
        
        echo -e "${YELLOW}💳 TUJUAN WITHDRAW:${NC}"
        echo -e "   $BANK_CODE | $DEST_NUMBER | $DEST_NAME"
        echo -e "   Fee: $(format_rupiah $FEE)"
        echo ""
        
        echo -e "${CYAN}📋 DAFTAR API KEY:${NC}"
        for i in "${!API_KEYS[@]}"; do
            num=$((i+1))
            key="${API_KEYS[$i]}"
            echo -e "$num. ${GREEN}API #$num${NC} - ${key:0:25}...${key: -10}"
        done
        echo "4. ✨ Input API Key sendiri"
        echo "5. ❌ Keluar"
        echo ""
        
        read -p "Pilih API Key (1-5): " pilih
        
        if [ "$pilih" = "5" ]; then
            echo -e "${GREEN}👋 Bye!${NC}"
            exit 0
        fi
        
        # Input nominal
        echo ""
        read -p "Nominal WD (contoh: 14000): " nominal
        
        if ! [[ "$nominal" =~ ^[0-9]+$ ]] || [ "$nominal" -le 0 ]; then
            echo -e "${RED}❌ Nominal tidak valid!${NC}"
            read -p "Enter buat lanjut..."
            continue
        fi
        
        net=$((nominal - FEE))
        echo -e "Net diterima: $(format_rupiah $net)"
        echo ""
        
        case $pilih in
            1|2|3)
                idx=$((pilih-1))
                withdraw "${API_KEYS[$idx]}" "$pilih" "$nominal"
                ;;
            4)
                echo ""
                read -p "Masukkan API Key: " custom_key
                if [ -n "$custom_key" ]; then
                    withdraw "$custom_key" "CUSTOM" "$nominal"
                else
                    echo -e "${RED}❌ API Key kosong${NC}"
                fi
                ;;
            *)
                echo -e "${RED}❌ Pilihan tidak valid${NC}"
                ;;
        esac
        
        echo ""
        read -p "Tekan Enter buat lanjut..."
    done
}

# Cek curl
if ! command -v curl &> /dev/null; then
    echo "❌ curl gak ada. Install dulu:"
    echo "   pkg install curl  (Termux)"
    echo "   apt-get install curl  (Linux)"
    exit 1
fi

# Jalanin
main
