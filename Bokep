                                   this.classList.contains('delete-btn') ? 'delete' :
                                   this.classList.contains('start-btn') ? 'start' :
                                   this.classList.contains('stop-btn') ? 'stop' : 'restart');
                    
                    const itemId = this.dataset.id || 'unknown';
                    
                    // Animasi klik
