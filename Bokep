#!/bin/bash

# ==================== SPAM CREATE QRIS ====================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# ==================== KONFIGURASI ====================
# Data tujuan (ganti sesuai kebutuhan)
DEST_NUMBER="083152799571"
DEST_NAME="HANARIANTI"

# 3 API KEY READY
API_KEYS=(
    "sZtKMW3BIL96FFMAnIIO22lRiO1cadQsxXHo7ljB2pZTVnu56EraFGqnGsLwqaZUFrGA9GT99kzNNg1BSU8mZpsavAHYZR6zC0pr"
    "xdpobigf1fXccFSahQ0A2EESm5A4XY2nK62F3pLxMIcHVGtjRLBOXypTkfvuF8DoZxhOaZmfVAlIpbeKoQW8DqHqpgStSiEuWSHk"
    "Ob2ON2EHS70Idc6f27MNI2aUynmFhXu4klJcqKgCQUrDkm3QXX4HhbZ0JndwoeK4ajeqkgyCCz4RN7QhfN2uGPuutkXCXGNYCFYQ"
)

# ==================== FUNGSI ====================

generate_ref_id() {
    echo "QR_$(date +%s%N)_$(cat /dev/urandom 2>/dev/null | tr -dc 'a-zA-Z0-9' | fold -w 6 | head -n 1 || echo "SPAM$RANDOM")"
}

show_header() {
    clear
    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║     💰 SPAM CREATE QRIS v1.0          ║${NC}"
    echo -e "${CYAN}║        3 API READY - LANGSUNG         ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
    echo ""
}

# Function create QRIS
create_qris() {
    local api_key=$1
    local api_num=$2
    local nominal=$3
    local ref_id=$(generate_ref_id)
    
    echo -e "${YELLOW}─────────────────────────────${NC}"
    echo -e "${PURPLE}🔑 API #$api_num | Ref: $ref_id${NC}"
    echo -e "${YELLOW}─────────────────────────────${NC}"
    
    # Data untuk create QRIS (sesuaikan dengan endpoint)
    local data="api_key=${api_key}&ref_id=${ref_id}&nominal=${nominal}&phone=${DEST_NUMBER}&name=${DEST_NAME}&type=qris"
    
    # Coba beberapa endpoint umum
    endpoints=(
        "https://atlantich2h.com/qris/create"
        "https://rumahotp.com/api/qris"
        "https://api.gateway.com/qris/create"
    )
    
    for endpoint in "${endpoints[@]}"; do
        echo -e "${CYAN}📤 Coba: $endpoint${NC}"
        
        response=$(curl -s -X POST "$endpoint" \
            -H "Content-Type: application/x-www-form-urlencoded" \
            -d "$data" \
            --max-time 10 \
            -w "\n%{http_code}")
        
        http_code=$(echo "$response" | tail -n1)
        response_body=$(echo "$response" | sed '$d')
        
        if [ "$http_code" = "200" ]; then
            echo -e "${GREEN}✅ SUKSES! (HTTP $http_code)${NC}"
            echo "$response_body" | jq '.' 2>/dev/null || echo "$response_body"
            
            # Log sukses
            echo "[$(date '+%H:%M:%S')] API#$api_num | $nominal | SUCCESS" >> qris_success.log
            return 0
        else
            echo -e "${RED}❌ Gagal (HTTP $http_code)${NC}"
        fi
    done
    
    echo -e "${RED}❌ Semua endpoint gagal untuk API #$api_num${NC}"
    echo "[$(date '+%H:%M:%S')] API#$api_num | $nominal | FAILED" >> qris_failed.log
    return 1
}

# ==================== MODE SPAM ====================

# Mode 1: Spam pake 1 API tertentu
spam_single() {
    local api_num=$1
    local nominal=$2
    local count=$3
    local delay=$4
    
    echo -e "${GREEN}🚀 Mulai spam API #$api_num - $count kali${NC}"
    echo -e "Nominal: $nominal | Delay: ${delay}s"
    echo ""
    
    for ((i=1; i<=count; i++)); do
        echo -e "${BLUE}[$i/$count]${NC} Spam ke-$i"
        create_qris "${API_KEYS[$((api_num-1))]}" "$api_num" "$nominal"
        
        if [ $i -lt $count ]; then
            echo -e "${YELLOW}⏳ Delay $delay detik...${NC}"
            sleep $delay
        fi
        echo ""
    done
}

# Mode 2: Spam pake semua API (round robin)
spam_all() {
    local nominal=$1
    local count=$2
    local delay=$3
    
    echo -e "${GREEN}🚀 Spam ALL API - $count kali per API${NC}"
    echo -e "Total: $((count * 3)) request | Delay: ${delay}s"
    echo ""
    
    for ((i=1; i<=count; i++)); do
        echo -e "${YELLOW}===== ROUND $i =====${NC}"
        
        for api_num in 1 2 3; do
            echo -e "${BLUE}[API #$api_num]${NC}"
            create_qris "${API_KEYS[$((api_num-1))]}" "$api_num" "$nominal"
            sleep $delay
        done
        echo ""
    done
}

# Mode 3: Spam loop forever
spam_forever() {
    local nominal=$1
    local delay=$2
    local mode=$3  # 1=single, 2=all
    
    echo -e "${GREEN}🔥 SPAM FOREVER MODE - Ctrl+C buat stop${NC}"
    echo -e "Nominal: $nominal | Delay: ${delay}s"
    echo -e "Log: qris_success.log & qris_failed.log"
    echo ""
    
    local round=1
    while true; do
        if [ "$mode" = "1" ]; then
            # Spam pake API 1,2,3 bergantian
            for api_num in 1 2 3; do
                echo -e "${YELLOW}[ROUND $round - API #$api_num]${NC}"
                create_qris "${API_KEYS[$((api_num-1))]}" "$api_num" "$nominal"
                sleep $delay
            done
        else
            # Spam all API sekaligus (pake background)
            echo -e "${YELLOW}[ROUND $round - PARALLEL]${NC}"
            for api_num in 1 2 3; do
                create_qris "${API_KEYS[$((api_num-1))]}" "$api_num" "$nominal" &
            done
            wait
            sleep $delay
        fi
        ((round++))
        echo ""
    done
}

# ==================== MAIN MENU ====================
main() {
    # Install jq kalo belum ada
    if ! command -v jq &> /dev/null; then
        echo -e "${YELLOW}⚠️  Install jq dulu...${NC}"
        apt install jq -y 2>/dev/null || pkg install jq -y 2>/dev/null
    fi
    
    while true; do
        show_header
        
        echo -e "${CYAN}📋 MENU SPAM QRIS:${NC}"
        echo "1. 🔥 Spam pake API #1 (sZtKMW3B...)"
        echo "2. 🔥 Spam pake API #2 (xdpobigf...)"
        echo "3. 🔥 Spam pake API #3 (Ob2ON2E...)"
        echo "4. ⚡ Spam GILIRAN (API 1-2-3 bergantian)"
        echo "5. 🚀 Spam ALL API (round robin)"
        echo "6. ♾️  Spam FOREVER (giliran)"
        echo "7. ⚡ Spam FOREVER (parallel)"
        echo "8. 📊 Lihat log"
        echo "9. ❌ Keluar"
        echo ""
        
        read -p "Pilih menu (1-9): " menu
        
        case $menu in
            1|2|3)
                read -p "Nominal QRIS (contoh: 10000): " nominal
                read -p "Jumlah spam: " count
                read -p "Delay (detik): " delay
                spam_single "$menu" "$nominal" "$count" "$delay"
                ;;
            4)
                read -p "Nominal QRIS: " nominal
                read -p "Jumlah per API: " count
                read -p "Delay (detik): " delay
                spam_all "$nominal" "$count" "$delay"
                ;;
            5)
                read -p "Nominal QRIS: " nominal
                read -p "Jumlah round: " count
                read -p "Delay (detik): " delay
                for ((i=1; i<=count; i++)); do
                    echo -e "${YELLOW}===== ROUND $i =====${NC}"
                    for api_num in 1 2 3; do
                        create_qris "${API_KEYS[$((api_num-1))]}" "$api_num" "$nominal"
                        sleep $delay
                    done
                done
                ;;
            6)
                read -p "Nominal QRIS: " nominal
                read -p "Delay (detik): " delay
                spam_forever "$nominal" "$delay" "1"
                ;;
            7)
                read -p "Nominal QRIS: " nominal
                read -p "Delay (detik): " delay
                spam_forever "$nominal" "$delay" "2"
                ;;
            8)
                echo -e "${CYAN}📊 LOG SUKSES:${NC}"
                tail -20 qris_success.log 2>/dev/null || echo "Belum ada log"
                echo ""
                echo -e "${RED}📊 LOG GAGAL:${NC}"
                tail -20 qris_failed.log 2>/dev/null || echo "Belum ada log"
                ;;
            9)
                echo -e "${GREEN}👋 Bye!${NC}"
                exit 0
                ;;
        esac
        
        echo ""
        read -p "Tekan Enter buat lanjut..."
    done
}

# Buat file log
touch qris_success.log qris_failed.log

# Jalanin
main
