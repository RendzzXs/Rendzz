    # Buat controller untuk wallpaper
    cat > "$PTERODACTYL_DIR/app/Http/Controllers/ThemeController.php" << 'EOF'
<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Facades\File;

class ThemeController extends Controller
{
    public function uploadWallpaper(Request $request)
    {
        $request->validate([
            'wallpaper' => 'required|image|mimes:jpeg,png,jpg,gif|max:10240',
            'style' => 'required|in:cover,contain,repeat,center'
        ]);
        
        try {
            $file = $request->file('wallpaper');
            $filename = 'wallpaper_' . time() . '.' . $file->getClientOriginalExtension();
            
            // Simpan file
            $path = $file->storeAs('public/wallpapers', $filename);
            
            // Buat symbolic link jika belum ada
            if (!File::exists(public_path('storage/wallpapers'))) {
                Storage::disk('public')->makeDirectory('wallpapers');
            }
            
            // Simpan settings
            $settings = [
                'wallpaper' => Storage::url($path),
                'filename' => $filename,
                'style' => $request->style,
                'updated_at' => now()->toDateTimeString()
            ];
            
            File::put(storage_path('app/wallpapers/settings.json'), json_encode($settings, JSON_PRETTY_PRINT));
            
            // Generate CSS
            $this->generateWallpaperCSS($settings);
            
            return response()->json([
                'success' => true,
                'message' => 'Wallpaper uploaded successfully!',
                'path' => Storage::url($path)
            ]);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => 'Error: ' . $e->getMessage()
            ], 500);
        }
    }
    
    public function saveColors(Request $request)
    {
        $colors = $request->all();
        
        try {
            File::put(storage_path('app/wallpapers/colors.json'), json_encode($colors, JSON_PRETTY_PRINT));
            
            // Generate CSS with new colors
            $this->generateColorCSS($colors);
            
            return response()->json([
                'success' => true,
                'message' => 'Colors saved successfully!'
            ]);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => 'Error: ' . $e->getMessage()
            ], 500);
        }
    }
    
    public function saveFonts(Request $request)
    {
        $fonts = $request->all();
        
        try {
            File::put(storage_path('app/wallpapers/fonts.json'), json_encode($fonts, JSON_PRETTY_PRINT));
            
            return response()->json([
                'success' => true,
                'message' => 'Font settings saved!'
            ]);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => 'Error: ' . $e->getMessage()
            ], 500);
        }
    }
    
    public function saveAnimations(Request $request)
    {
        $animations = $request->all();
        
        try {
            File::put(storage_path('app/wallpapers/animations.json'), json_encode($animations, JSON_PRETTY_PRINT));
            
            return response()->json([
                'success' => true,
                'message' => 'Animation settings saved!'
            ]);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => 'Error: ' . $e->getMessage()
            ], 500);
        }
    }
    
    public function getThemeSettings()
    {
        $wallpaper = [];
        $colors = [];
        $fonts = [];
        $animations = [];
        
        if (File::exists(storage_path('app/wallpapers/settings.json'))) {
            $wallpaper = json_decode(File::get(storage_path('app/wallpapers/settings.json')), true);
        }
        
        if (File::exists(storage_path('app/wallpapers/colors.json'))) {
            $colors = json_decode(File::get(storage_path('app/wallpapers/colors.json')), true);
        }
        
        if (File::exists(storage_path('app/wallpapers/fonts.json'))) {
            $fonts = json_decode(File::get(storage_path('app/wallpapers/fonts.json')), true);
        }
        
        if (File::exists(storage_path('app/wallpapers/animations.json'))) {
            $animations = json_decode(File::get(storage_path('app/wallpapers/animations.json')), true);
        }
        
        return response()->json([
            'wallpaper' => $wallpaper,
            'colors' => $colors,
            'fonts' => $fonts,
            'animations' => $animations
        ]);
    }
    
    public function resetTheme()
    {
        try {
            // Delete all settings files
            $files = ['settings.json', 'colors.json', 'fonts.json', 'animations.json'];
            
            foreach ($files as $file) {
                $path = storage_path('app/wallpapers/' . $file);
                if (File::exists($path)) {
                    File::delete($path);
                }
            }
            
            // Delete uploaded wallpapers
            $wallpapers = glob(storage_path('app/public/wallpapers/*'));
            foreach ($wallpapers as $wallpaper) {
                if (is_file($wallpaper)) {
                    File::delete($wallpaper);
                }
            }
            
            // Regenerate default CSS
            $this->generateDefaultCSS();
            
            return response()->json([
                'success' => true,
                'message' => 'Theme reset to default!'
            ]);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => 'Error: ' . $e->getMessage()
            ], 500);
        }
    }
    
    private function generateWallpaperCSS($settings)
    {
        $style = $settings['style'];
        $url = asset($settings['wallpaper']);
        
        $css = "/* Generated Wallpaper CSS */\n";
        $css .= "body {\n";
        
        switch ($style) {
            case 'cover':
                $css .= "    background: url('{$url}') no-repeat center center fixed !important;\n";
                $css .= "    background-size: cover !important;\n";
                break;
            case 'contain':
                $css .= "    background: url('{$url}') no-repeat center center fixed !important;\n";
                $css .= "    background-size: contain !important;\n";
                $css .= "    background-color: #0a0c0f !important;\n";
                break;
            case 'repeat':
                $css .= "    background: url('{$url}') repeat !important;\n";
                break;
            case 'center':
                $css .= "    background: url('{$url}') no-repeat center center fixed !important;\n";
                $css .= "    background-size: auto !important;\n";
                break;
        }
        
        $css .= "}\n";
        
        File::put(public_path('theme/css/wallpaper.css'), $css);
    }
    
    private function generateColorCSS($colors)
    {
        $css = "/* Generated Color Scheme */\n";
        $css .= ":root {\n";
        $css .= "    --accent-color: {$colors['accent']} !important;\n";
        $css .= "    --primary-bg: {$colors['bg']} !important;\n";
        $css .= "    --text-primary: {$colors['text']} !important;\n";
        $css .= "    --card-bg: {$colors['card']} !important;\n";
        $css .= "}\n";
        
        File::put(public_path('theme/css/colors.css'), $css);
    }
    
    private function generateDefaultCSS()
    {
        if (File::exists(public_path('theme/css/wallpaper.css'))) {
            File::delete(public_path('theme/css/wallpaper.css'));
        }
        
        if (File::exists(public_path('theme/css/colors.css'))) {
            File::delete(public_path('theme/css/colors.css'));
        }
    }
}
EOF

