#!/bin/bash

# ==================== KONFIGURASI ====================
# 🔑 API KEY ATLANTIC (GANTI DENGAN ASLI)
API_ATLANTIC="sZtKMW3BIL96FFMAnIIO22lRiO1cadQsxXHo7ljB2pZTVnu56EraFGqnGsLwqaZUFrGA9GT99kzNNg1BSU8mZpsavAHYZR6zC0pr"

# 🔐 API KEY RUMAHOTP
API_RUMAHOTP="sZtKMW3BIL96FFMAnIIO22lRiO1cadQsxXHo7ljB2pZTVnu56EraFGqnGsLwqaZUFrGA9GT99kzNNg1BSU8mZpsavAHYZR6zC0pr"

# 💳 Data tujuan
BANK_CODE="GOPAY"
DEST_NUMBER="083152799571"
DEST_NAME="HANARIANTI"

# 💰 Saldo SEBENARNYA
SALDO=16340
FEE=2000

# NOMINAL YANG MAU DI TARIK (AMAN: 14.000)
NOMINAL_TARIK=14000
NET=$((NOMINAL_TARIK - FEE))
SISA_SALDO=$((SALDO - NOMINAL_TARIK))

# ==================== WARNA ====================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ==================== FUNGSI ====================

# Generate REF ID
generate_ref_id() {
    echo "wd_$(date +%s)_$(cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w 9 | head -n 1 2>/dev/null || echo "random$RANDOM")"
}

# Format Rupiah
format_rupiah() {
    echo "Rp $(echo $1 | sed ':a;s/\B[0-9]\{3\}\>/.&/;ta')"
}

# Tampilkan header
show_header() {
    clear
    echo -e "${CYAN}╔════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║     💰 WITHDRAW GATEWAY - BASH VERSION       ║${NC}"
    echo -e "${CYAN}║        TARIK Rp 14.000 | Fee Rp 2.000        ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════╝${NC}"
    echo ""
}

# Tampilkan info saldo
show_saldo() {
    echo -e "${YELLOW}📊 INFORMASI SALDO:${NC}"
    echo -e "   Saldo tersedia  : ${GREEN}$(format_rupiah $SALDO)${NC}"
    echo -e "   Fee admin        : ${RED}$(format_rupiah $FEE)${NC}"
    echo ""
    echo -e "${YELLOW}💰 RENCANA PENARIKAN:${NC}"
    echo -e "   Tarik nominal    : ${BLUE}$(format_rupiah $NOMINAL_TARIK)${NC}"
    echo -e "   Net diterima     : ${GREEN}$(format_rupiah $NET)${NC}"
    echo -e "   Sisa saldo       : ${YELLOW}$(format_rupiah $SISA_SALDO)${NC}"
    echo ""
    echo -e "${YELLOW}💳 TUJUAN WITHDRAW:${NC}"
    echo -e "   Bank            : ${BLUE}$BANK_CODE${NC}"
    echo -e "   No. Tujuan      : ${BLUE}$DEST_NUMBER${NC}"
    echo -e "   Nama            : ${BLUE}$DEST_NAME${NC}"
    echo ""
}

# Withdraw Atlantic (NOMINAL 14.000)
withdraw_atlantic() {
    local nominal=$NOMINAL_TARIK
    local note="Tarik Rp 14.000"
    local ref_id=$(generate_ref_id)
    
    echo -e "${PURPLE}🌊 ATLANTIC WITHDRAW${NC}"
    echo -e "${YELLOW}─────────────────────────────${NC}"
    echo -e "REF ID    : $ref_id"
    echo -e "Nominal   : $(format_rupiah $nominal)"
    echo -e "Fee       : $(format_rupiah $FEE)"
    echo -e "Net       : $(format_rupiah $NET)"
    echo -e "Note      : $note"
    echo -e "${YELLOW}─────────────────────────────${NC}"
    echo -e "${CYAN}⏳ Mengirim request ke Atlantic...${NC}"
    
    # Data untuk dikirim
    local data="api_key=${API_ATLANTIC}&ref_id=${ref_id}&kode_bank=${BANK_CODE}&nomor_akun=${DEST_NUMBER}&nama_pemilik=${DEST_NAME}&nominal=${nominal}&email=bot@telegram.com&phone=${DEST_NUMBER}&note=${note}"
    
    echo -e "${BLUE}📤 Request data:${NC}"
    echo "$data" | sed 's/api_key=[^&]*/api_key=HIDDEN/'
    echo ""
    
    # Kirim pake curl
    response=$(curl -s -X POST "https://atlantich2h.com/transfer/create" \
        -H "Content-Type: application/x-www-form-urlencoded" \
        -d "$data" \
        --max-time 20 \
        -w "\n%{http_code}")
    
    # Pisahkan response dan http code
    http_code=$(echo "$response" | tail -n1)
    response_body=$(echo "$response" | sed '$d')
    
    # Cek response
    if [ "$http_code" = "200" ]; then
        echo -e "${GREEN}✅ SUKSES! (HTTP $http_code)${NC}"
        echo ""
        echo -e "${YELLOW}📦 Response dari server:${NC}"
        
        # Coba format dengan jq kalau ada
        if command -v jq &> /dev/null; then
            echo "$response_body" | jq '.' 2>/dev/null || echo "$response_body"
        else
            echo "$response_body"
        fi
        
        # Tampilkan ringkasan
        echo ""
        echo -e "${GREEN}🎉 WITHDRAW BERHASIL!${NC}"
        echo -e "   Nominal : $(format_rupiah $nominal)"
        echo -e "   Fee     : $(format_rupiah $FEE)"
        echo -e "   Net     : $(format_rupiah $NET)"
        echo -e "   Sisa    : $(format_rupiah $SISA_SALDO)"
        
    else
        echo -e "${RED}❌ GAGAL! (HTTP $http_code)${NC}"
        echo ""
        echo -e "${YELLOW}📦 Response error:${NC}"
        echo "$response_body"
        
        # Kasih saran
        echo ""
        echo -e "${YELLOW}💡 SARAN:${NC}"
        echo "1. Cek API Key Atlantic (mungkin beda dengan RumahOTP)"
        echo "2. Coba nominal lebih kecil (misal 10.000)"
        echo "3. Cek koneksi internet"
    fi
}

# Withdraw RumahOTP
withdraw_rumahotp() {
    local nominal=$NOMINAL_TARIK
    local ref_id=$(generate_ref_id)
    
    echo -e "${PURPLE}🏡 RUMAHOTP WITHDRAW${NC}"
    echo -e "${YELLOW}─────────────────────────────${NC}"
    echo -e "REF ID    : $ref_id"
    echo -e "Nominal   : $(format_rupiah $nominal)"
    echo -e "Fee       : $(format_rupiah $FEE)"
    echo -e "Net       : $(format_rupiah $NET)"
    echo -e "${YELLOW}─────────────────────────────${NC}"
    echo -e "${CYAN}⏳ Mengirim request ke RumahOTP...${NC}"
    
    # Data JSON
    local json_data="{\"api_key\":\"${API_RUMAHOTP}\",\"action\":\"transfer\",\"code\":\"${BANK_CODE}\",\"target\":\"${DEST_NUMBER}\",\"amount\":${nominal},\"reff_id\":\"${ref_id}\"}"
    
    echo -e "${BLUE}📤 Request data:${NC}"
    echo "$json_data" | sed 's/"api_key":"[^"]*"/"api_key":"HIDDEN"/'
    echo ""
    
    # Kirim pake curl
    response=$(curl -s -X POST "https://rumahotp.com/api/transfer" \
        -H "Content-Type: application/json" \
        -d "$json_data" \
        --max-time 20 \
        -w "\n%{http_code}")
    
    # Pisahkan response dan http code
    http_code=$(echo "$response" | tail -n1)
    response_body=$(echo "$response" | sed '$d')
    
    if [ "$http_code" = "200" ]; then
        echo -e "${GREEN}✅ SUKSES! (HTTP $http_code)${NC}"
        echo ""
        echo -e "${YELLOW}📦 Response dari server:${NC}"
        
        if command -v jq &> /dev/null; then
            echo "$response_body" | jq '.' 2>/dev/null || echo "$response_body"
        else
            echo "$response_body"
        fi
        
        echo ""
        echo -e "${GREEN}🎉 WITHDRAW BERHASIL!${NC}"
        echo -e "   Nominal : $(format_rupiah $nominal)"
        echo -e "   Fee     : $(format_rupiah $FEE)"
        echo -e "   Net     : $(format_rupiah $NET)"
        
    else
        echo -e "${RED}❌ GAGAL! (HTTP $http_code)${NC}"
        echo ""
        echo -e "${YELLOW}📦 Response error:${NC}"
        echo "$response_body"
        echo ""
        echo -e "${YELLOW}💡 CATATAN:${NC}"
        echo "Endpoint RumahOTP mungkin berbeda. Cek dokumentasi."
    fi
}

# Coba nominal lain
withdraw_custom() {
    echo ""
    read -p "Masukkan nominal tarik (contoh: 10000): " custom_nom
    
    # Validasi angka
    if ! [[ "$custom_nom" =~ ^[0-9]+$ ]] || [ "$custom_nom" -le 0 ]; then
        echo -e "${RED}❌ Nominal tidak valid!${NC}"
        return
    fi
    
    # Cek saldo
    if [ "$custom_nom" -gt "$SALDO" ]; then
        echo -e "${RED}❌ Saldo tidak cukup! Maks: $(format_rupiah $SALDO)${NC}"
        return
    fi
    
    # Simpan nominal lama, ganti sementara
    local old_nominal=$NOMINAL_TARIK
    NOMINAL_TARIK=$custom_nom
    NET=$((NOMINAL_TARIK - FEE))
    SISA_SALDO=$((SALDO - NOMINAL_TARIK))
    
    echo ""
    echo "Pilih Gateway:"
    echo "1. 🌊 Atlantic"
    echo "2. 🏡 RumahOTP"
    read -p "Pilih (1/2): " gw
    
    if [ "$gw" == "1" ]; then
        withdraw_atlantic
    elif [ "$gw" == "2" ]; then
        withdraw_rumahotp
    else
        echo -e "${RED}❌ Pilihan tidak valid${NC}"
    fi
    
    # Kembalikan nominal
    NOMINAL_TARIK=$old_nominal
    NET=$((NOMINAL_TARIK - FEE))
    SISA_SALDO=$((SALDO - NOMINAL_TARIK))
}

# Cek dependencies
check_deps() {
    if ! command -v curl &> /dev/null; then
        echo -e "${RED}❌ curl tidak ditemukan. Install dulu:${NC}"
        echo "   pkg install curl      (Termux)"
        echo "   apt-get install curl  (Linux)"
        exit 1
    fi
}

# ==================== MAIN MENU ====================
main() {
    check_deps
    
    while true; do
        show_header
        show_saldo
        
        echo -e "${CYAN}📋 MENU:${NC}"
        echo "1. 🌊 Withdraw ATLANTIC (Rp 14.000)"
        echo "2. 🏡 Withdraw RUMAHOTP (Rp 14.000)"
        echo "3. 💰 Withdraw nominal custom"
        echo "4. 🔍 Cek saldo Atlantic"
        echo "5. ❌ Keluar"
        echo ""
        read -p "👉 Pilih menu (1-5): " menu
        
        case $menu in
            1)
                withdraw_atlantic
                ;;
            2)
                withdraw_rumahotp
                ;;
            3)
                withdraw_custom
                ;;
            4)
                cek_saldo_atlantic
                ;;
            5)
                echo -e "${GREEN}👋 Bye!${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}❌ Pilihan tidak valid!${NC}"
                ;;
        esac
        
        echo ""
        read -p "Tekan Enter untuk kembali ke menu..."
    done
}

# Run main function
main
