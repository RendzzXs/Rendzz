#!/bin/bash

PHP_SERVICE="php8.1-fpm"
PANEL_DIR="/var/www/pterodactyl"

clear
echo "======================================="
echo " PTERODACTYL LOGIN OVERLOAD SIMULATOR"
echo "======================================="
echo ""
echo "1. Aktifkan 500 Error Login (Stop PHP)"
echo "2. Pulihkan Login Normal (Start PHP)"
echo "3. Status PHP"
echo ""
read -p "Pilih opsi (1/2/3): " opsi

if [ "$opsi" == "1" ]; then

    echo "[INFO] Menghentikan PHP-FPM..."
    systemctl stop $PHP_SERVICE
    echo "[SUCCESS] Login sekarang akan menghasilkan 500 error"

elif [ "$opsi" == "2" ]; then

    echo "[INFO] Menjalankan PHP-FPM..."
    systemctl start $PHP_SERVICE
    echo "[SUCCESS] Login kembali normal"

elif [ "$opsi" == "3" ]; then

    systemctl status $PHP_SERVICE --no-pager

else

    echo "[ERROR] Opsi tidak valid"

fi
